{
  "name": "ec487-penalty-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A static TypeScript client with authoritative Supabase multiplayer and an isolated local two-human test server.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --local && node scripts/server.mjs",
    "test": "node scripts/build.mjs --practice && node --test tests/*.test.mjs",
    "check:release": "node scripts/release-gate.mjs",
    "build:configured": "node --env-file=.env scripts/build.mjs",
    "test:http": "node scripts/http-tests.mjs",
    "test:config": "node scripts/check-config.mjs",
    "test:cloud": "node scripts/cloud-smoke.mjs",
    "test:postgres": "node scripts/postgres-tests.mjs",
    "test:load": "node scripts/load-test.mjs",
    "preview": "node scripts/build.mjs --practice",
    "build:unconfigured": "node scripts/build.mjs --allow-unconfigured"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
